# ─────────────────────────────────────────────────────────────────────────────
# ATTENDIFY — Environment Configuration
# DO NOT commit this file to version control (.gitignore already handles this)
# ─────────────────────────────────────────────────────────────────────────────

# ─── Firebase ─────────────────────────────────────────────────────────────────

# Relative paths are resolved from the project root (directory containing app.py).
# This file uses Firestore (Cloud Firestore), NOT the Realtime Database.
# HOW TO VERIFY IN FIREBASE CONSOLE:
#   1. Go to https://console.firebase.google.com → select project "attendify-a38fe"
#   2. Build → Firestore Database → confirm the database has been CREATED.
#      (If it says "Create Database", click it and choose a region, e.g. nam5 / us-east1)
#   3. Build → Authentication → ensure the service account has the correct permissions.
#
FIREBASE_CREDENTIALS_PATH=firebase_config.json

# ─── Excel Bulk Import ────────────────────────────────────────────────────────
# Optional: set a default Excel file path for bulk student import.
# Leave empty to always use the file picker in the Admin UI.
EXCEL_IMPORT_PATH=C:/Users/USER/Downloads/March-2026.xlsx
